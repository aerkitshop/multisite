# ---------------------------------------------------------------------------
# Multisite promo/affiliate CMS - environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (Postgres 16) -------------------------------------------------
# docker-compose builds DATABASE_URI from these three for the app container:
POSTGRES_USER=multisite
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=multisite
# Local dev (pnpm dev outside Docker) - point at your local Postgres:
DATABASE_URI=postgresql://multisite:change-me-long-random@127.0.0.1:5432/multisite

# --- Payload ----------------------------------------------------------------
# 32+ random chars: `openssl rand -hex 32`. Changing it invalidates sessions/API keys hashes.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# Public origin used by the admin panel (any one of your domains, or localhost for dev).
# Site URLs/canonicals come from each Site's "primaryDomain", not from this.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where uploaded media is stored (Docker: named volume mounted at /app/media)
MEDIA_DIR=./media

# --- Seed (demo data; only used by `pnpm seed`) -------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
# The seed refuses to run when NODE_ENV=production unless this is "true".
ALLOW_SEED_IN_PRODUCTION=false

# --- Cloudflare Tunnel (optional, docker compose --profile tunnel) -------------
# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker.
TUNNEL_TOKEN=

# --- Backups ------------------------------------------------------------------
# How many daily pg_dump files to keep in the backups volume.
BACKUP_KEEP_DAYS=14
